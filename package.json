{
  "name": "get-tsconfig-compat",
  "version": "2.1.4",
  "description": "Portable version of get-tsconfig for earlier versions of node.js",
  "keywords": [
    "tsconfig.json",
    "tsconfig",
    "get-tsconfig"
  ],
  "repository": {
    "type": "git",
    "url": "git@github.com:kmalakoff/get-tsconfig-compat.git"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/esm/index-esm.js",
      "require": "./dist/cjs/index-cjs.js"
    },
    "./package.json": "./package.json"
  },
  "main": "dist/cjs/index-cjs.js",
  "source": "src/index-esm.ts",
  "types": "dist/cjs/index-cjs.d.cts",
  "files": [
    "dist",
    "assets"
  ],
  "scripts": {
    "build": "tsds build",
    "format": "tsds format",
    "prepublishOnly": "tsds validate",
    "test": "tsds test:node --no-timeouts",
    "test:boundaries": "nvu 11.15.0,13.14.0,14.17.6,14.18.0,15.14.0,16.0.0 tsds test:node --no-timeouts test/exports/import.test.mjs test/exports/require.test.cjs",
    "test:engines": "nvu engines tsds test:node --no-timeouts test/unit/*.test.ts test/exports/require.test.cjs",
    "version": "tsds version"
  },
  "dependencies": {
    "core-js": "*",
    "get-tsconfig": "*",
    "is-absolute": "*",
    "path-posix": "*"
  },
  "devDependencies": {
    "@types/is-absolute": "^1.0.2",
    "@types/mocha": "*",
    "@types/node": "~0.12.25",
    "@types/slash": "*",
    "node-version-use": "*",
    "slash": "^1.0.0",
    "ts-dev-stack": "*",
    "tsds-config": "*"
  },
  "engines": {
    "node": ">=0.8"
  }
}
